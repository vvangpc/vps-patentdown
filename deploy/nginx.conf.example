server {
    listen 80;
    listen [::]:80;
    server_name patent.example.com;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/patentsdown-acme;
        default_type text/plain;
    }
    location / { return 308 https://patent.example.com$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name patent.example.com;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/patent.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/patent.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:PatentTLS:10m;
    ssl_session_timeout 1d;
    include /etc/nginx/snippets/patentsdown-cloudflare-allow.conf;
    client_max_body_size 16k;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    access_log /var/log/nginx/patentsdown-patent-access.log;
    error_log /var/log/nginx/patentsdown-patent-error.log;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_cache off;
    }
}
